---
import { site } from '../data/site';
const contacts = [
  { label: 'Email', href: `mailto:${site.email}` },
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'GitHub', href: site.github },
  { label: 'Resume', href: '/resume' },
];
const year = new Date().getFullYear();
---

<footer class="container">
  <div class="footer">
    <div class="signoff">
      <p class="display big">Summer 2027?</p>
      <p class="mono credit">© Lucy Lee {year} · Toronto</p>
    </div>

    <ul class="tags" aria-label="Contact links">
      {contacts.map((c) => (
        <li>
          <a href={c.href} class="tag label">{c.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    padding-bottom: var(--page-gutter);
    margin-top: var(--panel-gap);
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 32px;
    background: var(--cocoa);
    color: var(--cream);
    border-radius: var(--radius);
    padding: 48px;
  }

  .signoff p {
    margin: 0;
  }

  .big {
    font-size: clamp(3.5rem, 8vw, 6.875rem);
    color: var(--cream);
  }

  .credit {
    margin-top: 8px !important;
    font-size: 0.75rem;
    color: var(--powder-blue);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    display: inline-block;
    background: var(--cream);
    color: var(--ink);
    font-size: 1.375rem;
    letter-spacing: 0.02em;
    padding: 10px 16px;
    text-decoration: none;
  }

  .tags li:first-child .tag {
    transform: rotate(-6deg);
  }

  .tag:hover {
    background: var(--powder-blue);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 32px 24px;
    }
    .tag {
      font-size: 1.125rem;
    }
  }
</style>
