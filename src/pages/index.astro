---
import BaseLayout from '../layouts/BaseLayout.astro';
import Star from '../components/Star.astro';
import Photo from '../components/Photo.astro';
import { projects } from '../data/projects';

const navLinks = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Resume', href: '/resume' },
  { label: 'Contact', href: '/contact' },
];

const focusTags = [
  ['U of T', 'New Media + Statistics + Economics'],
  ['Fintech', 'UX/UI'],
];

const [featured, ...others] = projects;

const skills = [
  ['Design Systems', 'AKCSE : tokens + components'],
  ['Usability Tests', 'Roommates : real splits'],
  ['WCAG Audits', 'Contrast : 1.8 → 9.9 : 1'],
  ['Figma to React', 'Design : then ship it'],
  ['Team Sprints', '5 people : bi-weekly'],
];
---

<BaseLayout title="Lucy Lee - UX/Product Designer" showNav={false}>
  <!-- ===== HERO ===== -->
  <section class="panel hero" aria-labelledby="name">
    <div class="topbar">
      <nav aria-label="Main">
        <ul class="mini-nav">
          {navLinks.map((l) => <li><a class="mono" href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <a href="/contact" class="status mono">Open to Summer 2027 ↗</a>
    </div>

    <div class="title-row">
      <p class="role">Math student<br />turned product<br />designer</p>
    </div>

    <div class="name-wrap">
      <h1 id="name" class="display name">lucy lee</h1>
      <Star class="hero-star" size={90} rotate={12} />
    </div>

    <ul class="focus-tags mono">
      {focusTags.map(([a, b]) => <li>{a}<br />{b}</li>)}
    </ul>

    <a href="#work" class="cta">
      <span class="cta-label">See the work</span>
      <span class="cta-arrow" aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="panel intro" aria-labelledby="intro-title">
    <div class="collage">
      <figure class="polaroid">
        <Photo src="/images/me.jpg" tone="blue" ratio="300 / 340" alt="Smiling Lucy in Toronto" />
        <figcaption class="mono">In Toronto, 2026</figcaption>
      </figure>
      <p class="note">
        hi! i'm lucy. i started out writing java, python and c, and kept wondering why screens worked the way they did. now i design them.<br /><br />
        i also build in react and supabase, so i know what it takes to ship what i draw.
      </p>
      <Star class="c-star1" size={110} rotate={8} />
      <Star class="c-star2" size={70} rotate={-10} color="var(--cream)" />
    </div>

    <div class="statement">
      <h2 id="intro-title" class="statement-text">I learned to code first.<br /><span class="one-line">Now I design what gets built.</span></h2>
      <div class="meta">
        <p class="mono">Mathematics → New Media.<br />Java, Python, C → React, Supabase, Figma.</p>
      </div>
      <a href="/about" class="more">More about me ↗</a>
    </div>
  </section>

  <!-- ===== SELECTED WORK ===== -->
  <section id="work" class="panel work" aria-labelledby="work-title">
    <div class="work-head">
      <h2 id="work-title" class="big-head">Selected Work</h2>
      <p class="mono">: Three projects, 2025–2026</p>
    </div>

    {/* 케이스 스터디가 있는 Roomie만 크게, 나머지 둘은 짧은 목록으로 */}
    <article class="feature sticker-card" style="--tilt:-1deg">
      <div class="feature-shot">
        <Photo src={featured.image} alt={featured.alt} label={featured.placeholder} tone={featured.tone} ratio="352 / 250" />
      </div>
      <div class="feature-text">
        <h3>{featured.title}</h3>
        <ul class="mono caption">
          {featured.lines.map((line) => <li>: {line}</li>)}
        </ul>
        <a href={featured.href} class="btn mono">{featured.cta}</a>
      </div>
    </article>

    <ul class="others">
      {others.map((p) => (
        <li>
          <h3><a href={p.href}>{p.title} <span aria-hidden="true">↗</span></a></h3>
          <p class="mono">{p.lines.join(' · ')}</p>
        </li>
      ))}
    </ul>

    <Star class="work-star" size={120} rotate={14} color="var(--oxblood)" />
  </section>

  <!-- ===== ALSO ON THE TABLE ===== -->
  <section class="panel table" aria-labelledby="table-title">
    <div class="table-left">
      <h2 id="table-title" class="table-title">Also on<br />the table</h2>
    </div>

    <div class="blob">
      <Star class="blob-star" size={96} rotate={20} />
      <ul class="skills">
        {skills.map(([name, tag]) => (
          <li><span class="skill">{name}</span><span class="skill-tag mono">{tag}</span></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 공통 ---------- */
  .panel {
    position: relative;
    border-radius: var(--radius);
  }
  .ph {
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-align: center;
    padding: 8px;
  }
  .ph--blue { background: var(--powder-blue); color: var(--ink); }
  .ph--oxblood { background: var(--oxblood); color: var(--cream); }
  .ph--cocoa { background: var(--cocoa); color: var(--cream); }
  .ph--ink { background: var(--ink); color: var(--cream); }

  ul { list-style: none; margin: 0; padding: 0; }
  p, h1, h2, h3, figure { margin: 0; }

  /* ---------- HERO ---------- */
  .hero {
    background: var(--cream);
    padding: 28px 40px;
  }
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .mini-nav a {
    display: inline-block;
    padding: 2px 0;
    text-decoration: none;
  }
  .mini-nav a:hover { color: var(--oxblood); text-decoration: underline; }
  .status {
    background: var(--ink);
    color: var(--cream);
    padding: 8px 16px;
    text-decoration: none;
  }

  .title-row {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    gap: 24px;
    padding-top: 56px;
  }
  .role {
    font-family: var(--font-label);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(1.75rem, 3.6vw, 3.25rem); /* 최대 52px */
    line-height: 0.95;
    color: var(--oxblood);
    text-align: right;
  }

  .name-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 8px;
  }
  .name {
    font-size: clamp(5rem, 20.8vw, 18.75rem); /* 최대 300px */
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--oxblood);
    white-space: nowrap;
  }
  :global(.hero-star) {
    position: absolute;
    right: 10px;
    top: 10px;
    width: clamp(48px, 6.25vw, 90px);
    height: auto;
  }

  .focus-tags {
    display: flex;
    justify-content: space-between;
    padding-top: 8px;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .cta {
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    background: var(--ink);
    color: var(--cream);
    padding: 12px 24px;
    text-decoration: none;
  }
  .cta-label {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .cta-arrow { font-family: var(--font-label); font-size: 1.75rem; }
  .cta:hover { background: var(--oxblood); }

  /* ---------- INTRO ---------- */
  .intro {
    background: var(--oxblood);
    color: var(--cream);
    padding: 96px 48px 88px;
    display: grid;
    grid-template-columns: 520px 1fr;
    gap: 48px;
    align-items: center;
  }
  .collage {
    position: relative;
    height: 460px;
  }
  .polaroid {
    position: absolute;
    left: 10px;
    top: 20px;
    width: 324px;
    background: var(--cream);
    color: var(--ink);
    padding: 12px 12px 20px;
    transform: rotate(4deg);
  }
  .polaroid .ph { height: 340px; }
  .polaroid figcaption { margin-top: 10px; font-size: 0.75rem; }
  .note {
    position: absolute;
    left: 280px;
    top: 200px;
    width: 260px;
    background: var(--cream);
    color: var(--ink);
    border: 2px solid var(--ink);
    padding: 18px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    transform: rotate(-3deg);
  }
  :global(.c-star1) { position: absolute; left: 250px; top: -10px; }
  :global(.c-star2) { position: absolute; left: 440px; top: 380px; }

  .more {
  margin-top: 8px;
  align-self: flex-end;
  display: inline-block;
  background: var(--cream);
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  padding: 10px 16px;
  text-decoration: none;
  }
  .more:hover { background: var(--powder-blue); }

  .statement {
  container-type: inline-size;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24px;
  text-align: right;
  }

  .statement-text {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: min(4rem, 8cqi);
    line-height: 0.95;
  }
  .one-line { white-space: nowrap; }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .meta .mono { line-height: 1.4; }
  .est {
    font-family: var(--font-label);
    font-size: 2.5rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--powder-blue);
    white-space: nowrap;
  }

  /* ---------- SELECTED WORK ---------- */
  .work {
    background: var(--powder-blue);
    padding: 48px 48px 72px;
  }

  .work-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px 24px;
  }

  .big-head {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(3rem, 5.6vw, 5rem); /* 최대 80px */
    line-height: 1.3;
    text-transform: uppercase;
  }
  /* 대표 프로젝트 하나만 크게 */
  .feature {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 32px;
    align-items: end;
    padding: 16px 16px 24px;
    margin-top: 32px;
  }
  .feature-text { display: flex; flex-direction: column; gap: 14px; }
  .feature h3 {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(2.5rem, 4.4vw, 4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .caption { line-height: 1.5; }
  .btn {
    align-self: flex-start;
    background: var(--ink);
    color: var(--cream);
    padding: 8px 12px;
    font-size: 0.75rem;
    text-decoration: none;
  }
  .btn:hover { background: var(--oxblood); }

  /* 나머지 둘: 카드 대신 짧은 목록 */
  .others {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
    border-top: 2px solid var(--ink);
  }
  .others li { padding-top: 16px; display: flex; flex-direction: column; gap: 6px; }
  .others h3 {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .others a { text-decoration: none; }
  .others a:hover { color: var(--oxblood); text-decoration: underline; text-underline-offset: 5px; }
  :global(.work-star) { position: absolute; right: -30px; top: -40px; }

  /* ---------- ALSO ON THE TABLE ---------- */
  .table {
    background: var(--cream);
    padding: 56px 48px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 48px;
    align-items: center;
  }

  .table-left { order: 2; justify-self: end; text-align: right; }

  .table-title {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(3rem, 5.6vw, 5rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--oxblood);
  }

  .blob {
    position: relative;
    justify-self: start;
    background: var(--oxblood);
    color: var(--cream);
    border-radius: 160px;
    padding: 64px 72px;
  }
  :global(.blob-star) { position: absolute; left: 124px; top: -32px; }
  .skills { display: flex; flex-direction: column; gap: 22px; }
  .skills li { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .skill {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 2.75rem); /* 최대 44px */
    line-height: 1.3;
    text-transform: uppercase;
  }
  .skill-tag {
    background: var(--cream);
    color: var(--ink);
    padding: 4px 8px;
    font-size: 0.6875rem;
  }

  /* ---------- 태블릿 / 모바일 ---------- */
  @media (max-width: 1100px) {
    .intro { grid-template-columns: 1fr; }
    .collage { width: 520px; max-width: 100%; margin-inline: auto; }
    .table { grid-template-columns: 1fr; }
    .table-left { order: 0; justify-self: start; text-align: left; }
    .feature { grid-template-columns: 1fr; }
    .statement { align-items: flex-start; text-align: left; }
    .more { align-self: flex-start; }
  }

  @media (max-width: 768px) {
    .statement-text { font-size: 2.5rem; }
    .one-line { white-space: normal; }
    
    .hero { padding: 20px; }
    .title-row { flex-direction: column-reverse; align-items: flex-end; padding-top: 32px; }
    .focus-tags { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .cta-label { font-size: 1.375rem; }

    .intro, .work, .table { padding: 32px 20px; }
    .collage { transform: scale(0.62); transform-origin: top left; height: 290px; width: 520px; margin: 0; }
    .meta { flex-direction: column; }

    .work-head .mono, .work-head .big-head[aria-hidden] { display: none; }
    .others { grid-template-columns: 1fr; row-gap: 20px; }
    :global(.work-star) { width: 72px; height: 72px; right: -10px; top: -24px; }

    .blob { border-radius: 48px; padding: 40px 24px; justify-self: stretch; }
    :global(.blob-star) { width: 64px; height: 64px; left: auto; right: 24px; top: -24px; }
  }
</style>
