---
import BaseLayout from '../layouts/BaseLayout.astro';
import Star from '../components/Star.astro';
import Photo from '../components/Photo.astro';

const habits = [
  { title: 'Start with a complaint', text: 'Most of my projects begin with friends being annoyed. Roomie Receipts began with roommates splitting groceries on a calculator and arguing over who had already paid.' },
  { title: 'Try what exists', text: 'Before sketching, I use the tools people already have. Splitwise worked, but it asked everyone to download an app and sign up just to split groceries.' },
  { title: 'Sketch in Figma', text: 'I look for the step an existing tool makes hard, then sketch a simpler, more accessible version of that step.' },
  { title: 'Build it', text: 'I build the front end myself, so what I sketched is what people actually get.' },
  { title: 'Ship it and ask', text: 'I deploy it, hand it to the same friends, and ask what still bugs them. Critical feedback is the part I look forward to.' },
];

const currently = [
  ['Studying', 'Major in New Media · Minors in Statistics & Economics · U of T Scarborough, class of 2028'],
  ['Leading', 'Product Development Co-Director at AKCSE · bi-weekly sprints, roadmaps, MVP scoping'],
  ['Building', 'UofT Pathfinder · node-based course tree and mentorship'],
  ['Learning', 'Google UX Design Certificate, in progress'],
  ['Looking for', 'A Summer 2027 product design internship'],
];
---

<BaseLayout title="About — Lucy Lee" active="about" description="About Lucy (Siyoung) Lee: New Media student, product designer and React developer in Toronto.">
  <!-- HERO -->
  <section class="panel panel--cream hero" aria-labelledby="about-title">
    <div class="hero-text">
      <h1 id="about-title" class="word-title">about</h1>
      <p class="roles">New Media student.<br />Product designer.<br /> Front-end developer.</p>
    </div>
    <div class="collage">
      <figure class="sticker-card polaroid" style="--tilt:-3deg">
        <Photo src='/images/profile.jpg' tone="blue" ratio="380 / 440" alt="Portrait of Lucy Lee" />
        <figcaption class="kicker">University of Toronto</figcaption>
      </figure>
      <Star class="a-star1" size={110} rotate={10} color="var(--oxblood)" />
      <Star class="a-star2" size={70} rotate={-8} />
    </div>
  </section>

  <!-- STORY -->
  <section class="panel panel--oxblood story" aria-labelledby="story-title">
    <div>
      <h2 id="story-title" class="story-title">I'm Siyoung,<br />but call<br />me Lucy. :)</h2>
    </div>
    <div class="story-body">
  <p class="body-lg">I came to U of T in Mathematics on the International Scholar Award, a $100,000 merit scholarship. I was writing Java, Python and C, and I kept getting more curious about the people using the programs than about the programs themselves. So I switched to New Media (Joint Program) to study human-centred design (I LOVE IT!), and kept Statistics and Economics as minors.</p>
  <p class="body-lg">Economics is where fintech came in. In micro/macroeconomics I was learning how money moves, while my friends were opening their first investing apps and giving up on them. Those screens are hard for people our age, and that's the problem I want to work on.</p>
  <p class="body-lg">I still code. I build the front end of my own projects, so I know which parts of a design are quick to ship and which parts are hard. At AKCSE I co-direct five designers and developers building UofT Pathfinder, and I'm the New Media program's student representative.</p>
  <p class="body-lg">I also like going back to old work. A year after shipping <a href="/work/roomie-receipts">Roomie Receipts</a>, I audited it against WCAG, found a cent that quietly disappeared, and rebuilt it until every split added up and more people could actually use it.</p>
  
</div>
  </section>

  <!-- HOW I WORK -->
  <section class="panel panel--blue" aria-labelledby="how-title">
    <h2 id="how-title" class="big-head">How I work</h2>
    <ol class="reset steps">
      {habits.map((h, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <h3>{h.title}</h3>
          <p>{h.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- CURRENTLY -->
  <section class="panel panel--cream" aria-labelledby="now-title">
    <h2 id="now-title" class="now-title">Currently</h2>
    <dl class="now">
      {currently.map(([k, v]) => (
        <div class="now-row">
          <dt class="kicker">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 520px;
    gap: 48px;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; gap: 12px; }
  .roles {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(2rem, 3.9vw, 3.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .collage { position: relative; padding: 24px 40px 40px; }
  .polaroid {
    margin: 0;
    padding: 14px 14px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 412px;
  }
  :global(.a-star1) { position: absolute; left: 0; top: 0; }
  :global(.a-star2) { position: absolute; right: 20px; bottom: 0; }

  /* STORY */
  .story {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
    padding-block: 64px;
  }
  .story-title {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 0.92;
    text-transform: uppercase;
  }
  .story-body { display: flex; flex-direction: column; gap: 20px; max-width: 700px; }
  .story-body a { color: var(--powder-blue); text-underline-offset: 3px; }

  /* HOW I WORK */
  .steps { margin-top: 32px; border-top: 2px solid var(--ink); }
  .step {
    display: grid;
    grid-template-columns: 80px minmax(220px, 340px) 1fr;
    gap: 24px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--ink);
  }
  .step:last-child { border-bottom: 0; }
  .step-num { font-family: var(--font-display); font-size: 3.5rem; line-height: 1; color: var(--oxblood); }
  .step h3 {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .step p { margin: 0; font-size: 1.0625rem; line-height: 1.55; max-width: 560px; }

  /* CURRENTLY */
  .now-title {
    margin: 0 0 8px;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(2.5rem, 4.4vw, 4rem);
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--oxblood);
  }
  .now { margin: 0; }
  .now-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--ink);
  }
  .now-row:last-child { border-bottom: 0; }
  .now dd { margin: 0; font-weight: 500; font-size: 1.25rem; line-height: 1.4; }

  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; }
    .collage { max-width: 480px; }
    .story { grid-template-columns: 1fr; gap: 24px; padding-block: 40px; }
    .step { grid-template-columns: 56px 1fr; }
    .step p { grid-column: 2; }
    .step-num { font-size: 2.5rem; }
  }
  @media (max-width: 768px) {
    .collage { padding: 20px 16px 32px; }
    :global(.a-star1) { width: 72px; height: 72px; }
    .now-row { grid-template-columns: 1fr; gap: 4px; }
    .now dd { font-size: 1.0625rem; }
  }
</style>
